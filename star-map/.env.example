# DeepSeek API（不填 key 时引擎自动进入 Mock 模式，整条链路仍可跑通演示）
DEEPSEEK_API_KEY=sk-在这里填你的key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# Kimi（Moonshot）API：可选，仅用于「今日心情卡」按需设计（不填则用内置 18 色命名表）
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=kimi-k2.6

# 会话签名密钥（可选）：不填则自动生成并持久化到 data/.session-secret（请勿提交到 git）
# 生产环境建议显式设置一个 64 位随机字符串
SESSION_SECRET=
